# LLM 网关 API key（必填）。复制本文件为 .env 用于本地，或填入 GitHub 仓库 Secrets。
#
# 两种推荐接入方式（任选其一）：
#
# A) 地瓜 D-Robotics 网关（OpenAI 兼容，支持 glm-5.2 等）
#    控制台：https://ai.d-robotics.cc/
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://ai-api.d-robotics.cc/v1
LLM_MODEL=glm-5.2
#
# B) 智谱官网直连
#    LLM_API_KEY=your_zhipu_key
#    LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#    LLM_MODEL=glm-4.6
